---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { readFileSync } from 'fs';
import { execSync } from 'child_process';
import { join } from 'path';

const cargoToml = readFileSync(join(process.cwd(), '../Cargo.toml'), 'utf-8');
const version = cargoToml.match(/^version\s*=\s*"([^"]+)"/m)?.[1] ?? 'unknown';
const commit = (() => {
  try { return execSync('git rev-parse --short HEAD', { cwd: process.cwd() }).toString().trim(); }
  catch { return 'unknown'; }
})();

const PHP_VERSIONS = ['8.1', '8.2', '8.3', '8.4', '8.5', '8.6'];
const DEFAULT_PHP = '8.5';

const EXAMPLES = {
  'type-mismatch': {
    label: 'Type mismatch',
    code: `<?php

function add(int $a, int $b): int {
    return $a + $b;
}

$result = add("not a number", 42);
`,
  },
  'undefined-method': {
    label: 'Undefined method',
    code: `<?php

class User {
    public function getEmail(): string { return ''; }
}

$user = new User();
echo $user->getName();
`,
  },
  'nullability': {
    label: 'Null method call',
    code: `<?php

class User {
    public function name(): string { return ''; }
}

$user = null;
echo $user->name();
`,
  },
  'array-access': {
    label: 'Array access',
    code: `<?php

$counts = ['a' => 1, 'b' => 2];
echo $counts['missing'] + 1;
`,
  },
  'dead-code': {
    label: 'Dead code',
    code: `<?php

function greet(string $name): string {
    return "Hello, $name";
    echo 'never runs';
}

function helper(): void {
    $unused = 42;
}
`,
  },
  'taint': {
    label: 'Taint (SQL)',
    code: `<?php

function run_query(\\mysqli $db): void {
    mysqli_query($db, $_GET['sql']);
}
`,
  },
  'generics': {
    label: 'Generics',
    code: `<?php

/**
 * @template T of int
 * @param T $value
 * @return T
 */
function identity($value) {
    return $value;
}

identity("not an int");
`,
  },
};

const DEFAULT_CODE = EXAMPLES['type-mismatch'].code;

const BASE_URL = import.meta.env.BASE_URL.replace(/\/$/, '');
const issueDocs = import.meta.glob('../content/docs/reference/issues/*/*.md', { eager: true });
const ISSUE_DOCS = Object.fromEntries(
  Object.entries(issueDocs).map(([path, mod]: [string, any]) => {
    const slug = path.replace(/^.*\/reference\/issues\//, '').replace(/\.md$/, '');
    return [mod.frontmatter.title, { code: mod.frontmatter.code, url: `${BASE_URL}/reference/issues/${slug}/` }];
  }),
);
---

<StarlightPage
  frontmatter={{
    title: 'Playground',
    description: 'Try mir in your browser — no install required.',
    tableOfContents: false,
  }}
>
  <div
    class="playground not-content"
    data-base={import.meta.env.BASE_URL.replace(/\/$/, '')}
    data-examples={JSON.stringify(EXAMPLES)}
    data-issue-docs={JSON.stringify(ISSUE_DOCS)}
  >
    <div class="pg-toolbar">
      <div class="pg-drop" id="pg-example-wrap">
        <button type="button" class="pg-drop-btn" aria-haspopup="listbox" aria-expanded="false" aria-label="Example">
          <span class="pg-drop-val">Examples…</span>
          <svg aria-hidden="true" class="pg-drop-caret" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17 9.17a1 1 0 0 0-1.41 0L12 12.71 8.46 9.17a1 1 0 1 0-1.41 1.42l4.24 4.24a1.002 1.002 0 0 0 1.42 0L17 10.59a1.002 1.002 0 0 0 0-1.42Z"/></svg>
        </button>
        <ul class="pg-drop-list" role="listbox" aria-label="Example" hidden>
          {Object.entries(EXAMPLES).map(([k, v]) => (
            <li class="pg-drop-opt" role="option" data-value={k}>{v.label}</li>
          ))}
        </ul>
      </div>
      <div class="pg-drop" id="pg-version-wrap">
        <button type="button" class="pg-drop-btn" aria-haspopup="listbox" aria-expanded="false" aria-label="PHP version">
          <span class="pg-drop-val">PHP {DEFAULT_PHP}</span>
          <svg aria-hidden="true" class="pg-drop-caret" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17 9.17a1 1 0 0 0-1.41 0L12 12.71 8.46 9.17a1 1 0 1 0-1.41 1.42l4.24 4.24a1.002 1.002 0 0 0 1.42 0L17 10.59a1.002 1.002 0 0 0 0-1.42Z"/></svg>
        </button>
        <ul class="pg-drop-list" role="listbox" aria-label="PHP version" hidden>
          {PHP_VERSIONS.map(v => (
            <li class={`pg-drop-opt${v === DEFAULT_PHP ? ' pg-drop-opt--selected' : ''}`} role="option" data-value={v} aria-selected={v === DEFAULT_PHP ? 'true' : 'false'}>{`PHP ${v}`}</li>
          ))}
        </ul>
      </div>
      <button id="pg-btn" class="pg-btn" disabled title="Analyze (⌘/Ctrl+Enter)">Loading…</button>
      <button id="pg-share" class="pg-btn pg-btn--ghost" type="button" title="Copy shareable link">Share</button>
      <span id="pg-status" class="pg-status"></span>
      <span class="pg-meta">mir&nbsp;v{version}&nbsp;·&nbsp;{commit}</span>
    </div>

    <div class="pg-editor">
      <div id="pg-gutter" class="pg-gutter" aria-hidden="true">1</div>
      <div class="pg-input-wrap">
        <pre id="pg-highlight" class="pg-highlight" aria-hidden="true"></pre>
        <textarea
          id="pg-input"
          class="pg-input"
          spellcheck="false"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
        >{DEFAULT_CODE}</textarea>
        <div id="pg-overlay" class="pg-overlay" aria-hidden="true">
          <div id="pg-marks" class="pg-marks"></div>
        </div>
      </div>
    </div>

    <div id="pg-summary" class="pg-summary" aria-live="polite"></div>
    <div id="pg-diag" class="pg-diag"></div>
  </div>
</StarlightPage>

<script is:inline>
  const root      = document.querySelector('.playground');
  const BASE      = root.dataset.base;
  const WORKER_JS = `${BASE}/playground-worker.js`;
  const EXAMPLES  = JSON.parse(root.dataset.examples);
  const ISSUE_DOCS = JSON.parse(root.dataset.issueDocs);
  const DRAFT_KEY = 'mir-playground-draft';

  const btn       = document.getElementById('pg-btn');
  const shareBtn  = document.getElementById('pg-share');
  const input     = document.getElementById('pg-input');
  const highlight = document.getElementById('pg-highlight');
  const gutter    = document.getElementById('pg-gutter');
  const editor    = document.querySelector('.pg-editor');
  const diag      = document.getElementById('pg-diag');
  const status    = document.getElementById('pg-status');
  const summary   = document.getElementById('pg-summary');
  const marks     = document.getElementById('pg-marks');

  const verWrap  = document.getElementById('pg-version-wrap');
  const verBtn   = verWrap.querySelector('.pg-drop-btn');
  const verList  = verWrap.querySelector('.pg-drop-list');
  const exWrap   = document.getElementById('pg-example-wrap');
  const exBtn    = exWrap.querySelector('.pg-drop-btn');
  const exList   = exWrap.querySelector('.pg-drop-list');

  let pgVersion = verList.querySelector('.pg-drop-opt--selected')?.dataset.value ?? '8.5';

  let worker     = null;
  let ready      = false;
  let debounce   = null;
  let issues     = [];

  // ── PHP syntax highlighting ───────────────────────────────────────────────
  function highlightPhp(src) {
    const KW = new Set([
      'abstract','array','as','break','callable','case','catch','class','clone',
      'const','continue','declare','default','do','echo','else','elseif','empty',
      'enum','extends','final','finally','fn','for','foreach','function','goto',
      'if','implements','include','include_once','instanceof','insteadof',
      'interface','isset','list','match','namespace','new','print',
      'private','protected','public','readonly','require','require_once','return',
      'self','parent','static','switch','throw','trait','try','unset','use',
      'var','while','yield',
      // Scalar and return types
      'int','float','string','bool','void','never','mixed','object','iterable',
    ]);
    const CONST = new Set(['null','NULL','true','TRUE','false','FALSE']);

    const parts = [];
    let i = 0;
    let lastKw = '';

    function tok(cls, text) {
      if (cls) parts.push(`<span class="${cls}">${esc(text)}</span>`);
      else parts.push(esc(text));
    }

    while (i < src.length) {
      const rest = src.slice(i);
      let m;

      // PHP open/close tags
      if ((m = /^<\?(?:php\b|=)?/i.exec(rest))) {
        tok('hl-tag', m[0]); i += m[0].length; lastKw = ''; continue;
      }
      if ((m = /^\?>/.exec(rest))) {
        tok('hl-tag', m[0]); i += m[0].length; lastKw = ''; continue;
      }

      // Block comments (including unclosed)
      if (rest.startsWith('/*')) {
        const end = rest.indexOf('*/');
        const s = end === -1 ? rest : rest.slice(0, end + 2);
        tok('hl-comment', s); i += s.length; continue;
      }

      // Line comments
      if ((m = /^\/\/[^\n]*/.exec(rest)) || (m = /^#(?!\[)[^\n]*/.exec(rest))) {
        tok('hl-comment', m[0]); i += m[0].length; continue;
      }

      // Strings — single quoted
      if ((m = /^'(?:[^'\\]|\\.)*'/.exec(rest))) {
        tok('hl-str', m[0]); i += m[0].length; lastKw = ''; continue;
      }
      // Strings — double quoted
      if ((m = /^"(?:[^"\\]|\\.)*"/.exec(rest))) {
        tok('hl-str', m[0]); i += m[0].length; lastKw = ''; continue;
      }
      // Unclosed strings (take to end of line)
      if (rest[0] === "'" || rest[0] === '"') {
        const nl = rest.indexOf('\n');
        const s = nl === -1 ? rest : rest.slice(0, nl);
        tok('hl-str', s); i += s.length; continue;
      }

      // Numbers
      if ((m = /^(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|\d[\d_]*(?:\.\d[\d_]*)?(?:[eE][+-]?\d+)?)/.exec(rest))) {
        tok('hl-num', m[0]); i += m[0].length; lastKw = ''; continue;
      }

      // $this (special variable)
      if ((m = /^\$this\b/.exec(rest))) {
        tok('hl-this', m[0]); i += m[0].length; lastKw = ''; continue;
      }

      // Variables
      if ((m = /^\$[a-zA-Z_][a-zA-Z0-9_]*/.exec(rest))) {
        tok('hl-var', m[0]); i += m[0].length; lastKw = ''; continue;
      }

      // Identifiers: keywords, constants, class names, function calls
      if ((m = /^[a-zA-Z_\\][a-zA-Z0-9_\\]*/.exec(rest))) {
        const word = m[0];
        if (CONST.has(word)) {
          tok('hl-const', word); lastKw = '';
        } else if (KW.has(word)) {
          tok('hl-kw', word); lastKw = word;
        } else {
          // Check if followed by '(' (skip optional spaces/tabs)
          const after = rest.slice(word.length).replace(/^[ \t]*/, '');
          if (after[0] === '(') {
            tok('hl-fn', word);
          } else if (lastKw === 'new' || lastKw === 'extends' || lastKw === 'instanceof' || /^[A-Z]/.test(word)) {
            tok('hl-type', word);
          } else {
            tok('', word);
          }
          lastKw = '';
        }
        i += word.length; continue;
      }

      // Operators
      if ((m = /^(?:->|=>|::|\?\?=|\?\?|===|!==|<=>|\+\+|--|\.\.\.|[+\-*\/%&|^~<>!=]=?|[?:@])/.exec(rest))) {
        tok('hl-op', m[0]); i += m[0].length; lastKw = ''; continue;
      }

      // Punctuation
      if (/^[{}[\]();,.]/.test(rest[0])) {
        tok('hl-punct', rest[0]); i++; lastKw = ''; continue;
      }

      // Whitespace — preserve, don't clear lastKw so `new Foo` works across spaces
      if ((m = /^\s+/.exec(rest))) {
        parts.push(esc(m[0])); i += m[0].length; continue;
      }

      parts.push(esc(rest[0])); i++;
    }

    return parts.join('') + '\n';
  }

  function updateHighlight() {
    highlight.innerHTML = highlightPhp(input.value);
    highlight.scrollTop  = input.scrollTop;
    highlight.scrollLeft = input.scrollLeft;
  }

  // ── URL share encoding (UTF-8 → base64url) ────────────────────────────────
  function encodeCode(s) {
    return btoa(unescape(encodeURIComponent(s)))
      .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  }
  function decodeCode(s) {
    try {
      const pad = '='.repeat((4 - s.length % 4) % 4);
      const b64 = s.replace(/-/g, '+').replace(/_/g, '/') + pad;
      return decodeURIComponent(escape(atob(b64)));
    } catch { return null; }
  }

  function setVersion(v) {
    pgVersion = v;
    verBtn.querySelector('.pg-drop-val').textContent = `PHP ${v}`;
    verList.querySelectorAll('[role="option"]').forEach(o => {
      const s = o.dataset.value === v;
      o.classList.toggle('pg-drop-opt--selected', s);
      o.setAttribute('aria-selected', String(s));
    });
  }

  function hasVersion(v) {
    return [...verList.querySelectorAll('[role="option"]')].some(o => o.dataset.value === v);
  }

  function loadDraft() {
    try { return JSON.parse(localStorage.getItem(DRAFT_KEY) ?? 'null'); } catch { return null; }
  }
  function saveDraft() {
    try { localStorage.setItem(DRAFT_KEY, JSON.stringify({ code: input.value, php: pgVersion })); } catch {}
  }

  // A shared link wins over the local draft.
  function readHash() {
    const h = new URLSearchParams(location.hash.slice(1));
    const code = h.get('code');
    const php  = h.get('php');
    const decoded = code ? decodeCode(code) : null;
    if (decoded != null) {
      input.value = decoded;
      if (php && hasVersion(php)) setVersion(php);
      return;
    }
    const draft = loadDraft();
    if (draft && typeof draft.code === 'string') {
      input.value = draft.code;
      if (hasVersion(draft.php)) setVersion(draft.php);
    }
  }
  readHash();

  shareBtn.addEventListener('click', async () => {
    const url = new URL(location.href);
    url.hash = `code=${encodeCode(input.value)}&php=${encodeURIComponent(pgVersion)}`;
    const href = url.toString();
    history.replaceState(null, '', href);
    try {
      await navigator.clipboard.writeText(href);
      const prev = shareBtn.textContent;
      shareBtn.textContent = 'Copied';
      setTimeout(() => { shareBtn.textContent = prev; }, 1200);
    } catch {
      // Clipboard blocked — URL is at least in the address bar now.
    }
  });

  // ── Line numbers + textarea height ───────────────────────────────────────
  const SEV_RANK = { error: 0, warning: 1, info: 2 };

  function updateGutter() {
    const n = input.value.split('\n').length;
    const worst = new Map();
    for (const i of issues) {
      const s = i.severity.toLowerCase();
      const prev = worst.get(i.line);
      if (prev === undefined || SEV_RANK[s] < SEV_RANK[prev]) worst.set(i.line, s);
    }
    gutter.innerHTML = Array.from({ length: n }, (_, k) => {
      const s = worst.get(k + 1);
      return `<div class="pg-ln${s ? ` pg-ln--${s}` : ''}">${k + 1}</div>`;
    }).join('');
  }

  function updateInputHeight() {
    input.style.height = 'auto';
    // scrollHeight excludes a horizontal scrollbar; add it so the last line isn't covered.
    input.style.height = input.scrollHeight + (input.offsetHeight - input.clientHeight) + 'px';
  }

  input.addEventListener('input', () => { updateGutter(); updateInputHeight(); });
  updateGutter();
  updateInputHeight();

  // ── Keyboard: Tab indents, Cmd/Ctrl+Enter analyzes ───────────────────────
  const INDENT = '    ';
  function replaceRange(start, end, text, selStart, selEnd) {
    input.setSelectionRange(start, end);
    // execCommand keeps the native undo stack; fall back where it's unsupported.
    if (!document.execCommand('insertText', false, text)) {
      input.setRangeText(text, start, end);
      input.dispatchEvent(new Event('input'));
    }
    input.setSelectionRange(selStart, selEnd);
  }

  input.addEventListener('keydown', e => {
    if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) {
      e.preventDefault();
      clearTimeout(debounce);
      runAnalysis();
      return;
    }
    if (e.key !== 'Tab' || e.altKey || e.metaKey || e.ctrlKey) return;
    e.preventDefault();
    const v = input.value;
    const { selectionStart: s, selectionEnd: t } = input;
    if (!e.shiftKey && s === t) {
      replaceRange(s, t, INDENT, s + INDENT.length, s + INDENT.length);
      return;
    }
    const lineStart = v.lastIndexOf('\n', s - 1) + 1;
    const blockEnd  = t > s && v[t - 1] === '\n' ? t - 1 : t;
    const lines = v.slice(lineStart, blockEnd).split('\n');
    let firstDelta = 0;
    const changed = lines.map((l, idx) => {
      if (!e.shiftKey) { if (idx === 0) firstDelta = INDENT.length; return INDENT + l; }
      const n = l.match(/^( {1,4}|\t)/)?.[0].length ?? 0;
      if (idx === 0) firstDelta = -n;
      return l.slice(n);
    }).join('\n');
    const total = changed.length - (blockEnd - lineStart);
    replaceRange(lineStart, blockEnd, changed,
      Math.max(lineStart, s + firstDelta), t + total);
  });

  // ── Custom dropdowns ──────────────────────────────────────────────────────
  function setupDrop(dropBtn, dropList) {
    const close = () => { dropList.hidden = true; dropBtn.setAttribute('aria-expanded', 'false'); };
    const open  = () => { dropList.hidden = false; dropBtn.setAttribute('aria-expanded', 'true'); };
    dropBtn.addEventListener('click', e => { e.stopPropagation(); dropList.hidden ? open() : close(); });
    document.addEventListener('click', close);
    document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
    return close;
  }
  const closeVer = setupDrop(verBtn, verList);
  const closeEx  = setupDrop(exBtn, exList);

  verList.addEventListener('click', e => {
    const opt = e.target.closest('[role="option"]');
    if (!opt) return;
    setVersion(opt.dataset.value);
    closeVer();
    runAnalysis();
  });

  // ── Examples ──────────────────────────────────────────────────────────────
  exList.addEventListener('click', e => {
    const opt = e.target.closest('[role="option"]');
    if (!opt) return;
    const ex = EXAMPLES[opt.dataset.value];
    if (!ex) return;
    input.value = ex.code;
    exBtn.querySelector('.pg-drop-val').textContent = ex.label;
    closeEx();
    updateGutter();
    updateInputHeight();
    updateHighlight();
    runAnalysis();
  });

  // ── Analyzer worker ───────────────────────────────────────────────────────
  // One request in flight; newer requests replace the queued one.
  let seq       = 0;
  let inFlight  = null;
  let queued    = null;
  let busyTimer = null;

  function loadFailed(message) {
    status.textContent = 'Failed to load analyzer.';
    btn.textContent = 'Unavailable';
    btn.disabled = true;
    console.error(message);
  }

  function send(req) {
    inFlight = req;
    clearTimeout(busyTimer);
    busyTimer = setTimeout(() => { status.textContent = 'Analyzing…'; }, 150);
    worker.postMessage(req);
  }

  function onWorkerMessage({ data }) {
    if (data.type === 'ready') {
      ready = true;
      btn.textContent = 'Analyze';
      btn.disabled = false;
      runAnalysis();
      return;
    }
    if (data.type === 'load-error') { loadFailed(data.message); return; }

    inFlight = null;
    if (queued) { const next = queued; queued = null; send(next); }
    else { clearTimeout(busyTimer); status.textContent = ''; }

    // Results for superseded text would mark the wrong ranges.
    if (data.id !== seq) return;
    if (data.type === 'result') {
      issues = data.issues.sort((a, b) =>
        a.line - b.line || a.col_start - b.col_start ||
        SEV_RANK[a.severity.toLowerCase()] - SEV_RANK[b.severity.toLowerCase()]);
      renderSummary(data.ms, data.php);
      renderIssues();
    } else {
      issues = [];
      summary.innerHTML = '<span class="pg-sum pg-sum--error">Analysis error — see console</span>';
      diag.innerHTML = '';
      console.error(data.message);
    }
    updateGutter();
    renderMarks();
  }

  function loadWorker() {
    try {
      worker = new Worker(WORKER_JS, { type: 'module' });
    } catch (e) { loadFailed(e); return; }
    worker.addEventListener('message', onWorkerMessage);
    worker.addEventListener('error', e => loadFailed(e.message || e));
  }

  function esc(s) {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  // ── Inline issue marks ────────────────────────────────────────────────────
  let charW = null;
  function getCharWidth() {
    if (charW) return charW;
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    ctx.font = getComputedStyle(input).font;
    charW = ctx.measureText('x').width;
    return charW;
  }

  // Visual column of a 0-based code-point column, expanding tabs.
  function visualCol(text, col) {
    const chars = [...text];
    let v = 0;
    for (let k = 0; k < col && k < chars.length; k++) {
      v = chars[k] === '\t' ? v + 4 - (v % 4) : v + 1;
    }
    return v + Math.max(0, col - chars.length);
  }

  // One segment per covered line; columns are 0-based code points with an exclusive end.
  function issueSegments(issue, lines) {
    const last = Math.max(issue.line, issue.line_end || issue.line);
    const segs = [];
    for (let ln = issue.line; ln <= last && ln <= lines.length; ln++) {
      const text  = lines[ln - 1];
      const len   = [...text].length;
      const start = ln === issue.line ? issue.col_start : text.match(/^\s*/)[0].length;
      const end   = ln === last && issue.col_end > start ? issue.col_end : len;
      segs.push({ ln, from: visualCol(text, start), to: visualCol(text, end) });
    }
    return segs;
  }

  function renderMarks() {
    const computed = getComputedStyle(input);
    const lineH    = parseFloat(computed.lineHeight) || 22;
    const padTop   = parseFloat(computed.paddingTop)  || 16;
    const padLeft  = parseFloat(computed.paddingLeft) || 16;
    const cw       = getCharWidth();
    const lines    = input.value.split('\n');
    marks.innerHTML = issues.map((issue, idx) =>
      issueSegments(issue, lines).map(({ ln, from, to }) => {
        const top   = padTop + ln * lineH - 3;
        const left  = padLeft + from * cw;
        const width = Math.max(cw, (to - from) * cw);
        return `<div class="pg-mark pg-mark--${issue.severity.toLowerCase()}" data-idx="${idx}"
          style="top:${top}px;left:${left}px;width:${width}px"></div>`;
      }).join('')
    ).join('');
    syncMarksScroll();
  }

  function syncMarksScroll() {
    marks.style.transform = `translateX(${-input.scrollLeft}px)`;
  }

  function setActive(idx) {
    marks.querySelectorAll('.pg-mark--active').forEach(m => m.classList.remove('pg-mark--active'));
    if (idx == null) return;
    marks.querySelectorAll(`[data-idx="${idx}"]`).forEach(m => m.classList.add('pg-mark--active'));
  }

  input.addEventListener('scroll', () => {
    highlight.scrollLeft = input.scrollLeft;
    syncMarksScroll();
  });

  diag.addEventListener('mouseover', e => {
    const card = e.target.closest('.pg-issue');
    setActive(card ? card.dataset.idx : null);
  });
  diag.addEventListener('mouseleave', () => setActive(null));
  diag.addEventListener('click', e => {
    if (e.target.closest('a')) return;
    const card = e.target.closest('.pg-issue');
    if (!card) return;
    const issue = issues[+card.dataset.idx];
    const lines = input.value.split('\n');
    const lineH = parseFloat(getComputedStyle(input).lineHeight) || 22;
    editor.scrollTop = Math.max(0, (issue.line - 1) * lineH - editor.clientHeight / 3);
    const offset = lines.slice(0, issue.line - 1).reduce((n, l) => n + l.length + 1, 0);
    const lineText = lines[issue.line - 1] ?? '';
    const pos = offset + [...lineText].slice(0, issue.col_start).join('').length;
    input.focus({ preventScroll: true });
    input.setSelectionRange(pos, pos);
  });

  function plural(n, word) { return `${n} ${word}${n === 1 ? '' : 's'}`; }

  function renderSummary(ms, php) {
    const count = s => issues.filter(i => i.severity.toLowerCase() === s).length;
    const parts = [];
    const e = count('error'), w = count('warning'), n = count('info');
    if (e) parts.push(`<span class="pg-sum pg-sum--error">${plural(e, 'error')}</span>`);
    if (w) parts.push(`<span class="pg-sum pg-sum--warning">${plural(w, 'warning')}</span>`);
    if (n) parts.push(`<span class="pg-sum pg-sum--info">${n} info</span>`);
    if (!parts.length) parts.push('<span class="pg-sum pg-sum--ok">No issues</span>');
    summary.innerHTML = `${parts.join('')}<span class="pg-sum-time">${ms < 1 ? '&lt;1' : ms.toFixed(0)}&nbsp;ms · PHP&nbsp;${esc(php)}</span>`;
  }

  function renderIssues() {
    if (!issues.length) {
      diag.innerHTML = '';
      return;
    }
    diag.innerHTML = issues.map((i, idx) => {
      const s = i.severity.toLowerCase();
      const doc = ISSUE_DOCS[i.name];
      const name = doc
        ? `<a class="pg-issue-name" href="${doc.url}" target="_blank" rel="noopener" title="Open ${esc(i.name)} docs">${esc(i.name)}</a>`
        : `<span class="pg-issue-name">${esc(i.name)}</span>`;
      const code = doc?.code ? `<span class="pg-issue-code">${esc(doc.code)}</span>` : '';
      return `<div class="pg-issue pg-issue--${s}" data-idx="${idx}">
        <div class="pg-issue-head">
          <span class="pg-dot"></span>
          ${name}${code}
          <span class="pg-issue-loc">line&nbsp;${i.line}:${i.col_start + 1}</span>
        </div>
        <div class="pg-issue-msg">${esc(i.message)}</div>
      </div>`;
    }).join('');
  }

  function runAnalysis() {
    clearTimeout(debounce);
    saveDraft();
    if (!ready) return;
    const req = { id: ++seq, code: input.value, php: pgVersion };
    if (inFlight) queued = req; else send(req);
  }

  btn.addEventListener('click', runAnalysis);
  input.addEventListener('input', () => {
    seq++;
    updateHighlight();
    // Stale marks would point at shifted text until the next analysis.
    marks.innerHTML = '';
    exBtn.querySelector('.pg-drop-val').textContent = 'Examples…';
    clearTimeout(debounce);
    debounce = setTimeout(runAnalysis, 400);
  });
  window.addEventListener('resize', () => { charW = null; renderMarks(); });

  updateHighlight();
  loadWorker();
</script>
